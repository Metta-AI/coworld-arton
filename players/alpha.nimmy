# Alpha. Expands to the most cost effective neutral planets first and
# only commits to attacks its strike group can actually win.
#
# Target score, lower is better:
#   (garrison + margin + dist / 8) * growth
# Cheap, close and fast growing planets come first. A strike group is
# up to three of our planets closest to the target, sent only when
# their combined ships beat the expected defense at arrival.

proc dist(x1, y1, x2, y2) =
  let dx = x1 - x2
  let dy = y1 - y2
  return isqrt(dx * dx + dy * dy)

proc findPlanet(id) =
  for planet in planets():
    if planet.id == id:
      return planet

proc nearestOwnDist(x, y) =
  var best = 999999
  for planet in planets():
    if planet.owner == myId():
      let d = dist(planet.x, planet.y, x, y)
      if d < best:
        best = d
  return best

proc playerTotal(id) =
  var total = 0
  for planet in planets():
    if planet.owner == id:
      total = total + planet.ships
  return total


proc strikeGroup(x, y) =
  # Up to three of our planets closest to the target.
  var group = []
  for round in 0 ..< 3:
    var bestId = -1
    var bestDist = 999999
    for planet in planets():
      if planet.owner == myId() and not contains(group, planet.id):
        let d = dist(planet.x, planet.y, x, y)
        if d < bestDist:
          bestDist = d
          bestId = planet.id
    if bestId != -1:
      group.add(bestId)
  return group

proc tryAttack(target) =
  # Sends a strike group when it can win. Returns true only when a
  # new wave was actually launched.
  let group = strikeGroup(target.x, target.y)
  if len(group) == 0:
    return false
  var power = 0
  var far = 0
  for id in group:
    let planet = findPlanet(id)
    # We send at 70 percent, keeping a garrison at home.
    power = power + (planet.ships * 7) div 10
    let d = dist(planet.x, planet.y, target.x, target.y)
    if d > far:
      far = d
  # Defense at arrival: the garrison, a safety margin, and for player
  # planets everything they will produce while our ships fly in.
  # Travel takes about four ticks per five pixels.
  var defense = target.ships + 4
  if target.owner != 0:
    defense = defense + ((far * 4) div 5) div target.growth + 4
  if power > defense:
    select(group)
    sendTo(target.id)
    return true
  return false

proc neutralTargets() =
  # Neutral planet ids, most cost effective first.
  var ids = []
  var scores = []
  for planet in planets():
    if planet.owner == 0:
      let d = nearestOwnDist(planet.x, planet.y)
      # Heavy distance penalty, two ships per pixel: expanding next
      # door beats shipping across the map, always. Growth counts
      # squared, so a big planet is worth paying for and a slow
      # small one rarely is.
      let base = planet.ships + 4 + d * 2
      ids.add(planet.id)
      scores.add(base * planet.growth * planet.growth)
  var order = []
  for round in 0 ..< len(ids):
    var bestIndex = -1
    var bestScore = 999999999
    for i in 0 ..< len(ids):
      if not contains(order, ids[i]) and scores[i] < bestScore:
        bestScore = scores[i]
        bestIndex = i
    order.add(ids[bestIndex])
  return order

proc enemyTargets() =
  # Enemy planet ids, closest to our planets first.
  var ids = []
  var dists = []
  for planet in planets():
    if planet.owner != 0 and planet.owner != myId():
      ids.add(planet.id)
      dists.add(nearestOwnDist(planet.x, planet.y))
  var order = []
  for round in 0 ..< len(ids):
    var bestIndex = -1
    var bestDist = 999999999
    for i in 0 ..< len(ids):
      if not contains(order, ids[i]) and dists[i] < bestDist:
        bestDist = dists[i]
        bestIndex = i
    order.add(ids[bestIndex])
  return order

proc alivePlayers() =
  var seen = []
  for planet in planets():
    if planet.owner != 0 and not contains(seen, planet.owner):
      seen.add(planet.owner)
  return len(seen)

proc underAttackByOthers(enemyId) =
  # True when a third player already has ships flying at the enemy.
  for ship in ships():
    if ship.owner != myId() and ship.owner != enemyId:
      let target = findPlanet(ship.target)
      if target.owner == enemyId:
        return true
  return false

proc tick() =
  if gameTick() % 60 != 0:
    return
  setOffense(70)

  # Expand: take cost effective neutrals as fast as we can win them.
  # Targets already being taken are skipped, not waited on, so many
  # captures can be in the air at once. Neutrals that anyone else is
  # already flying at are skipped too: no point stacking onto the
  # same cheap planet everyone noticed at once.
  for targetId in neutralTargets():
    if inbound(targetId) == 0:
      if tryAttack(findPlanet(targetId)):
        return

  # No war on purpose while neutral planets remain. Waves already in
  # the air still hit a player when someone takes the neutral first,
  # which is attacking by accident and fine.
  for planet in planets():
    if planet.owner == 0:
      return

  # War: work through enemy planets closest first, like expansion.
  # Weaker owners are fair game. Stronger owners only once someone
  # else already started on them, or in a duel where nobody else is
  # ever coming to start the fight for us.
  for targetId in enemyTargets():
    if inbound(targetId, myId()) == 0:
      let enemy = findPlanet(targetId)
      var allowed = false
      if playerTotal(myId()) > playerTotal(enemy.owner) + 10:
        allowed = true
      else:
        if underAttackByOthers(enemy.owner):
          allowed = true
        else:
          if alivePlayers() == 2:
            allowed = true
      if allowed:
        if tryAttack(enemy):
          return
