# Alpha. Attacks the most cost effective planets first and only
# commits to attacks its strike group can actually win.
#
# Target score, lower is better:
#   (garrison + margin + dist * 8) * growth^3, times 4 for players
# Close big planets come first, weak players next door beat neutrals
# across the map. A strike group is up to three of our planets
# closest to the target, sent only when their combined ships beat
# the expected defense at arrival. Rear planets ferry ships to the
# most endangered front planet whenever no strike launches.

proc dist(x1, y1, x2, y2) =
  let dx = x1 - x2
  let dy = y1 - y2
  return isqrt(dx * dx + dy * dy)

proc findPlanet(id) =
  for planet in planets():
    if planet.id == id:
      return planet

proc nearestOwnDist(x, y) =
  var best = 999999
  for planet in planets():
    if planet.owner == myId():
      let d = dist(planet.x, planet.y, x, y)
      if d < best:
        best = d
  return best

proc playerTotal(id) =
  var total = 0
  for planet in planets():
    if planet.owner == id:
      total = total + planet.ships
  return total


proc strikeGroup(x, y) =
  # Up to three of our planets closest to the target.
  var group = []
  for round in 0 ..< 3:
    var bestId = -1
    var bestDist = 999999
    for planet in planets():
      if planet.owner == myId() and not contains(group, planet.id):
        let d = dist(planet.x, planet.y, x, y)
        if d < bestDist:
          bestDist = d
          bestId = planet.id
    if bestId != -1:
      group.add(bestId)
  return group

proc tryAttack(target) =
  # Sends a strike group when it can win. Returns true only when a
  # new wave was actually launched.
  let group = strikeGroup(target.x, target.y)
  if len(group) == 0:
    return false
  var power = 0
  var far = 0
  for id in group:
    let planet = findPlanet(id)
    # We send at 70 percent, keeping a garrison at home.
    power = power + (planet.ships * 7) div 10
    let d = dist(planet.x, planet.y, target.x, target.y)
    if d > far:
      far = d
  # Defense at arrival: the garrison, a safety margin, and for player
  # planets everything they will produce while our ships fly in.
  # Travel takes about four ticks per five pixels.
  var defense = target.ships + 4
  if target.owner != 0:
    defense = defense + ((far * 4) div 5) div target.growth + 4
  if power > defense:
    select(group)
    sendTo(target.id)
    return true
  return false

proc warAllowed(ownerId) =
  # Weaker players are fair game. Stronger players only once someone
  # else already started on them, or in a duel where nobody else is
  # ever coming to start the fight for us.
  if playerTotal(myId()) > playerTotal(ownerId) + 10:
    return true
  if underAttackByOthers(ownerId):
    return true
  if alivePlayers() == 2:
    return true
  return false

proc rankedTargets() =
  # Every planet worth attacking, most cost effective first. Heavy
  # distance penalty: expanding next door beats shipping across the
  # map, always. Growth counts cubed, so big planets are always
  # worth going for over the little ones. Enemy planets cost four
  # times as much on top, so a close neutral beats a weak player,
  # but a weak player next door beats a neutral far away.
  var ids = []
  var scores = []
  for planet in planets():
    if planet.owner != myId():
      if planet.owner == 0 or warAllowed(planet.owner):
        let d = nearestOwnDist(planet.x, planet.y)
        # Eight ships of cost per pixel: anything far away has to be
        # spectacular to be worth it.
        let base = planet.ships + 4 + d * 8
        var score = base * planet.growth * planet.growth * planet.growth
        if planet.owner != 0:
          score = score * 4
        ids.add(planet.id)
        scores.add(score)
  var order = []
  for round in 0 ..< len(ids):
    var bestIndex = -1
    var bestScore = 999999999999999
    for i in 0 ..< len(ids):
      if not contains(order, ids[i]) and scores[i] < bestScore:
        bestScore = scores[i]
        bestIndex = i
    if bestIndex != -1:
      order.add(ids[bestIndex])
  return order

proc nearestEnemyDist(x, y) =
  var best = 999999
  for planet in planets():
    if planet.owner != 0 and planet.owner != myId():
      let d = dist(planet.x, planet.y, x, y)
      if d < best:
        best = d
  return best

proc reinforce() =
  # Funnel ships from safe rear planets to the most endangered own
  # planet, danger being proximity to enemy planets.
  var dangerId = -1
  var dangerDist = 999999
  for planet in planets():
    if planet.owner == myId():
      let d = nearestEnemyDist(planet.x, planet.y)
      if d < dangerDist:
        dangerDist = d
        dangerId = planet.id
  if dangerId == -1:
    return
  # One ferry at a time, wait for the last one to land.
  if inbound(dangerId, myId()) > 0:
    return
  var sources = []
  for planet in planets():
    if planet.owner == myId() and planet.id != dangerId:
      if len(sources) < 3 and planet.ships >= 10:
        # Only clearly safe planets send, twice as far from the
        # enemy as the endangered one.
        if nearestEnemyDist(planet.x, planet.y) > dangerDist * 2:
          sources.add(planet.id)
  if len(sources) > 0:
    select(sources)
    sendTo(dangerId)

proc alivePlayers() =
  var seen = []
  for planet in planets():
    if planet.owner != 0 and not contains(seen, planet.owner):
      seen.add(planet.owner)
  return len(seen)

proc underAttackByOthers(enemyId) =
  # True when a third player already has ships flying at the enemy.
  for ship in ships():
    if ship.owner != myId() and ship.owner != enemyId:
      let target = findPlanet(ship.target)
      if target.owner == enemyId:
        return true
  return false

proc tick() =
  if gameTick() % 60 != 0:
    return
  setOffense(70)

  # One ranked list for neutrals and enemy planets together. Targets
  # already being taken are skipped, not waited on, so many captures
  # can be in the air at once. Neutrals that anyone else is already
  # flying at are skipped too: no point stacking onto the same cheap
  # planet everyone noticed at once.
  for targetId in rankedTargets():
    let target = findPlanet(targetId)
    var free = false
    if target.owner == 0:
      free = inbound(targetId) == 0
    else:
      free = inbound(targetId, myId()) == 0
    if free:
      if tryAttack(target):
        return

  # No strike this cycle: shore up the front line instead. Safety
  # runs from the first tick of the game.
  reinforce()
